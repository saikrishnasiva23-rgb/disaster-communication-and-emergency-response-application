# Copy to .env and adjust. Never commit a real .env.
# All settings can also be given as plain environment variables
# (that is how cloud platforms and docker-compose pass them).

# development | testing | production
ENVIRONMENT=development

# Local development default (file next to this one):
DATABASE_URL=sqlite:///./disaster_dev.db
# Production (PostgreSQL). postgres:// and postgresql:// URLs from hosting
# providers are accepted and converted to the asyncpg driver automatically.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

# REQUIRED in production, >= 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Left empty in development, a random per-process secret is used (tokens
# then stop working when the server restarts).
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated browser origins allowed by CORS (web dashboards only;
# the Android / Windows apps are not affected by CORS).
CORS_ORIGINS=

# Old Flask-compatible /api/rescue-request(s) endpoints used by the current
# Flutter build. UNAUTHENTICATED. Default: on in development, off otherwise.
# LEGACY_API_ENABLED=true

# Creates tables at startup without Alembic (quick local runs / tests only).
# Normal path: `alembic upgrade head`.
AUTO_CREATE_TABLES=false

# Optional one-time bootstrap of the first administrator (only when no
# admin exists yet). Remove the password from the environment afterwards.
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Login / registration attempts allowed per client IP (+ username) per window.
RATE_LIMIT_AUTH_ATTEMPTS=10
RATE_LIMIT_AUTH_WINDOW_SECONDS=300

# Reject client timestamps further than this in the future.
MAX_CLOCK_SKEW_MINUTES=120
# Max items per sync request / page.
SYNC_BATCH_LIMIT=100

# Extra emergency type codes, comma-separated (e.g. TSUNAMI,GAS_LEAK).
EXTRA_EMERGENCY_TYPES=

LOG_LEVEL=INFO
# JSON logs for log aggregators; false = human-readable lines.
LOG_JSON=true

# Bind address / port (cloud platforms usually inject PORT).
HOST=0.0.0.0
PORT=8000

# Demo seed script only (scripts/seed_demo.py); never used by the server.
# DEMO_PASSWORD=
